{
  "name": "vren-ai-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/generate-icons.mjs && wxt build",
    "zip": "node scripts/generate-icons.mjs && wxt zip",
    "postinstall": "node scripts/generate-icons.mjs && wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/chrome": "^0.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.11"
  }
}


# Vren AI Backend Environment Configuration
ENV=development
APP_NAME=Vren AI API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://tauri.localhost,http://tauri.localhost,tauri://localhost,null

# Option A (Recommended): Local Postgres or `docker compose -f backend/docker-compose.yml up -d`
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/vren_ai
# Option B (Zero-install local file DB):
# DATABASE_URL=sqlite+aiosqlite:///./storage/vren_local.db

# Auth ("local" now; switch to "supabase" + SUPABASE_JWT_SECRET when migrating)
AUTH_MODE=local
JWT_SECRET=change-this-to-a-long-random-local-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Local private document storage (max 5 MB, 10 pages)
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=5
MAX_CV_PAGES=10

# ---------------------------------------------------------------------------
# AI CONFIGURATION: Gemini (Primary) with OpenAI (Fallback)
#   1) GEMINI_API_KEY=...       Primary AI answers (Gemini 2.5 Flash) and optional STT.
#   2) OPENAI_API_KEY=sk-...    Fallback AI answers (GPT-4o Mini) and Whisper STT.
#
# If Gemini is unavailable, rate-limited, or encounters an issue, Vren AI
# automatically falls back to OpenAI so your interview session is never interrupted.
# ---------------------------------------------------------------------------

# Server-side AI Provider (never expose keys to browser)
# Primary provider: "gemini" (recommended), "openai_compatible", or "offline"
LLM_PROVIDER=gemini

# Primary: Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fallback: OpenAI (used automatically if Gemini fails or is rate-limited)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Speech-to-Text provider ("deepgram", "openai_compatible", "gemini", or "offline")
# flux-general-en is English only. For other languages use DEEPGRAM_MODEL=nova-3.
STT_PROVIDER=offline
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-en
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Optional SMTP transactional email delivery (leave empty to log/use dev tokens)
APP_WEB_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@vren.local

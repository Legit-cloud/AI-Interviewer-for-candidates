# Vren AI Backend Environment Configuration
ENV=development
APP_NAME=Vren AI API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Option A (Recommended): Local Postgres or `docker compose -f backend/docker-compose.yml up -d`
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/vren_ai
# Option B (Zero-install local file DB):
# DATABASE_URL=sqlite+aiosqlite:///./storage/vren_local.db

# Auth ("local" now; switch to "supabase" + SUPABASE_JWT_SECRET when migrating)
AUTH_MODE=local
JWT_SECRET=change-this-to-a-long-random-local-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Local private document storage (max 5 MB, 10 pages)
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=5
MAX_CV_PAGES=10

# ---------------------------------------------------------------------------
# REQUIRED FOR LIVE ANSWERS. Without these the live page works but shows
# "Answer unavailable" (no answers) and nothing is transcribed.
#   1) LLM_API_KEY      writes the answers (any OpenAI-compatible API, or use GEMINI_API_KEY)
#   2) STT_PROVIDER + its key   turns the interviewer's audio into text
#        recommended: STT_PROVIDER=deepgram and DEEPGRAM_API_KEY=...   (streaming, lowest delay)
#        alternative: STT_PROVIDER=openai_compatible and STT_API_KEY=... (Whisper, per-utterance)
# Keys stay on the server. Check what is active at http://localhost:8000/v1/health ("ai").
# ---------------------------------------------------------------------------

# Server-side AI Provider (never expose keys to browser)
# Options: "openai_compatible" (OpenAI / Groq / co.agentrouter.org), "gemini", or "offline"
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://agentrouter.org/v1
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5-20250929
GEMINI_API_KEY=

# Speech-to-Text provider ("deepgram", "openai_compatible", "gemini", or "offline")
# flux-general-en is English only. For other languages use DEEPGRAM_MODEL=nova-3.
STT_PROVIDER=offline
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-en
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Optional SMTP transactional email delivery (leave empty to log/use dev tokens)
APP_WEB_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@vren.local
